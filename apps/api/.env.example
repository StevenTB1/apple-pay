# Copy to .env.local in this app. Keep real values private; none belong in NEXT_PUBLIC_*.
# Runtime: Supabase PostgreSQL transaction pooler URL (port 6543) for the hosted API.
# Locally, DATABASE_URL and DIRECT_URL can use the same direct PostgreSQL connection.
# Use a postgres:// or postgresql:// URL, not the HTTPS Supabase project URL.
# Configure TLS in the connection string (for example, sslmode=require for Supabase).
DATABASE_URL=
# Prisma migrations: direct PostgreSQL URL or session pooler URL (port 5432).
# Use the session pooler if this computer cannot reach the direct IPv6 endpoint.
# Generation and schema validation work without either database URL.
DIRECT_URL=
# Supabase project URL and publishable key for validating the owner's sign-in token.
# Use the publishable key, not the service-role secret.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Exact Supabase Auth user UUID permitted to review and edit this personal ledger.
OWNER_USER_ID=
# Stable random source UUID for this iPhone's Shortcut uploads.
SHORTCUT_SOURCE_ID=
# SHA-256 hex digest of the upload-only Shortcut secret; store the raw secret on the phone.
# This authenticates uploads and does not prove the identity of a physical phone.
SHORTCUT_TOKEN_SHA256=
