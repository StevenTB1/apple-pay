# Copy to .env.local in this app. Keep real values private; none belong in NEXT_PUBLIC_*.
# Supabase project URL (https://<ref>.supabase.co).
SUPABASE_URL=
# Service-role / secret key. The API is the only holder; it bypasses RLS, so every
# service filters by the signed-in user's id. Never put this in the web app or the phone.
SUPABASE_SERVICE_ROLE_KEY=
# Prisma migrations only (npm run db:migrate): session pooler URL on port 5432.
# The running API does not use a PostgreSQL connection string.
DIRECT_URL=
# Upstash Redis REST credentials for rate limiting. Left empty, rate limiting is disabled (fail open).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
