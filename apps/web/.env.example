# Optional: your computer's LAN hostname/IP, without protocol or port.
# Used by next.config.ts when viewing the dev server from your phone.
DEV_ORIGIN_HOST=

# Public Supabase URL and publishable/anon key for owner email/password sign-in.
# Never use a service-role/secret key. No database or phone credentials belong here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only upstream endpoint. The phone calls the web app's same-origin API route.
GRAPHQL_API_URL=http://127.0.0.1:3001/api/graphql
