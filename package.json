{
  "name": "apple-pay",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @apple-pay/web dev",
    "dev:api": "pnpm --filter @apple-pay/api dev",
    "dev:lan": "pnpm --filter @apple-pay/web dev:lan",
    "build": "pnpm -r build",
    "start": "pnpm --filter @apple-pay/web start",
    "start:api": "pnpm --filter @apple-pay/api start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "prisma:validate": "pnpm --filter @apple-pay/api prisma:validate",
    "db:migrate": "pnpm --filter @apple-pay/api db:migrate"
  }
}
